{
  "name": "ahani-server",
  "version": "1.0.0",
  "description": "Node server for Ahani",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start:dev": "nodemon --env-file-if-exists=ahani.dev.env server.mjs",
    "start:prod": "node --env-file-if-exists=ahani.prod.env server.mjs",
    "start:debug": "node --inspect server.mjs"
  },
  "imports": {
    "#app": "./app/main.mjs",
    "#config": "./app/config/config.mjs",
    "#controllers": "./app/api/controllers.mjs",
    "#logger": "./libraries/logging/logger.mjs",
    "#utilities": "./utils.mjs"
  },
  "keywords": [
    "ahani",
    "server"
  ],
  "author": "Rye",
  "license": "ISC"
}
